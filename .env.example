# Supabase project URL (Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key: prefer service_role for trusted server-side CRUD (bypasses RLS).
# For local tests with only anon key, ensure migrations include permissive RLS policies as in this repo.
SUPABASE_KEY=your-service-role-or-anon-key

# Google AI Studio / Gemini API key
GEMINI_API_KEY=

# Optional: defaults to gemini-2.0-flash if your API supports it
# GEMINI_MODEL=gemini-1.5-flash

# main.py: must match user_config.telegram_id (also used as private chat_id)
TELEGRAM_ID=

# @BotFather token; required for main.py notifications and for callback polling:
#   python -m src.telegram_bot
TELEGRAM_BOT_TOKEN=

# Sunday weekly report window uses this timezone (evening = 18:00–24:00 local)
WEEKLY_REPORT_TZ=Europe/Moscow

# GitHub Actions: store the same OAuth client JSON as repo secret CREDENTIALS_JSON

# After auth_setup --type tasks (Google Tasks for fertur account)
# tasks_refresh_token is stored in Supabase user_config (no local env needed).

# Edge Function secrets (Supabase dashboard): GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET,
# TELEGRAM_BOT_TOKEN, SUPABASE_SERVICE_ROLE_KEY, optional TELEGRAM_WEBHOOK_SECRET

# Optional path to Gmail OAuth client JSON (default: credentials.json)
# GMAIL_CREDENTIALS_PATH=credentials.json
